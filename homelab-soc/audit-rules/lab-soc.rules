## Cambios en archivos críticos de usuarios/contraseñas
-w /etc/passwd -p wa -k passwd_changes
-w /etc/shadow -p wa -k shadow_changes
-w /etc/group -p wa -k group_changes
-w /etc/sudoers -p wa -k sudoers_changes

## Ejecución de comandos (todos los binarios que se corren)
-a always,exit -F arch=b64 -S execve -k command_execution

## Uso de sudo
-w /usr/bin/sudo -p x -k sudo_usage

## Cambios en configuración SSH
-w /etc/ssh/sshd_config -p wa -k sshd_config_changes

## Login/logout y sesiones
-w /var/log/faillog -p wa -k login_failures
-w /var/log/lastlog -p wa -k login_success
